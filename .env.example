BOT_TOKEN=
ADMIN_IDS=

# 可选：不设置时也可以在机器人里绑定
REQUIRED_GROUP_ID=
REQUIRED_GROUP_URL=
REPOSITORY_CHAT_ID=

# Deplexo 持久化目录
DATA_FILE=/data/database.json

# 可选：数据库备份文件，默认与 DATA_FILE 同目录生成 database.json.bak
DATA_BACKUP_FILE=/data/database.json.bak

# 资源索引上限
MAX_RESOURCES=20000

# 上传连续无文件等待时间（秒），默认 180 秒
UPLOAD_IDLE_SECONDS=180

# 历史扫描（可选）
TG_API_ID=
TG_API_HASH=
TG_SESSION=
STORAGE_KEY=

# Google Sheets（用于多机器人共享目录/资源）
GOOGLE_SHEETS_ID=1-7f_dKaSU66sbftuT2RM1ctf5-VY6KLxU1AJhGmI8D8
GOOGLE_SHEETS_TAB=Sheet1
# 推荐：Google Cloud 服务账号 JSON；也可填 JSON 的 Base64
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_B64=
# 临时 OAuth Access Token（不推荐，约 1 小时过期）
GOOGLE_ACCESS_TOKEN=

# MySQL 主数据库（FadeHost 私有 MySQL）
DB_HOST=db-6192b58a9e664cbfb2e389b6b2d473c7
DB_PORT=3306
DB_NAME=fh6192b58a9e664cbfb2e389b6b2d473c7
DB_USER=root
DB_PASSWORD=填写 FadeHost 显示的实际密码
