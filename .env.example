BOT_TOKEN=
ADMIN_IDS=

# 可选：不设置时也可以在机器人里绑定
REQUIRED_GROUP_ID=
REQUIRED_GROUP_URL=
REPOSITORY_CHAT_ID=

# Deplexo 持久化目录
DATA_FILE=/data/database.json

# 可选：数据库备份文件，默认与 DATA_FILE 同目录生成 database.json.bak
DATA_BACKUP_FILE=/data/database.json.bak

# 资源索引上限
MAX_RESOURCES=20000

# 上传连续无文件等待时间（秒），默认 180 秒
UPLOAD_IDLE_SECONDS=180

# 历史扫描（可选）
TG_API_ID=
TG_API_HASH=
TG_SESSION=
STORAGE_KEY=

# Baserow（可选：用于多机器人共享目录/资源）
BASEROW_API_URL=https://api.baserow.io
BASEROW_TOKEN=
BASEROW_TABLE_ID=
# 兼容旧部署变量名；BASEROW_TOKEN 优先
BASEROW_API_TOKEN=

# MySQL 主数据库（FadeHost 私有 MySQL）
DB_HOST=db-6192b58a9e664cbfb2e389b6b2d473c7
DB_PORT=3306
DB_NAME=fh6192b58a9e664cbfb2e389b6b2d473c7
DB_USER=root
DB_PASSWORD=填写 FadeHost 显示的实际密码
# 也可使用 DATABASE_URL；配置后优先使用 DATABASE_URL
# DATABASE_URL=mysql://root:密码@db-6192b58a9e664cbfb2e389b6b2d473c7:3306/fh6192b58a9e664cbfb2e389b6b2d473c7
