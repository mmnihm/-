BOT_TOKEN=
ADMIN_IDS=

# 可选：不设置时也可以在机器人里绑定
REQUIRED_GROUP_ID=
REQUIRED_GROUP_URL=
REPOSITORY_CHAT_ID=

# Deplexo 持久化目录
DATA_FILE=/data/database.json

# 可选：数据库备份文件，默认与 DATA_FILE 同目录生成 database.json.bak
DATA_BACKUP_FILE=/data/database.json.bak

# 资源索引上限
MAX_RESOURCES=20000

# 上传连续无文件等待时间（秒），默认 180 秒
UPLOAD_IDLE_SECONDS=180

# 历史扫描（可选）
TG_API_ID=
TG_API_HASH=
TG_SESSION=
STORAGE_KEY=
